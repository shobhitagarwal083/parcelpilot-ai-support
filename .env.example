# Which provider drives the agent: "google" (default), "groq" or "openrouter".
#
# Both speak the OpenAI chat-completions shape, so one adapter reaches either
# and switching is this line plus the matching key. That is only possible
# because the model never arbitrates between sources and never computes a
# number -- the rule engine, calendar, retrieval and access control contain no
# model call at all. Run the same question through both providers and the ₹
# amounts come out byte-identical, because neither model produced them.
MODEL_PROVIDER=google

# Google AI Studio -- https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq -- https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter -- https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any key you set is also used as failover, in FAILOVER_PROVIDERS order -- free
# quota is metered per project, so a second *vendor* is the only fallback that
# survives one vendor being exhausted. Providers with no key are skipped.
#
# Only app/agent/provider.py reads these. Phases 00-04 use no model at all;
# the policy engine, retrieval and access control all run and test without a key.
